# Copy to .env (git-ignored). Anything set here overrides router_config.json.

# Jev fallback (and PROVIDER=jev). Get a key from TypeSafe AI.
TYPESAFE_API_KEY=

# LayaModel service (often on another device). The token is needed when the service has LAYA_ADMIN_PASSWORD set:
# make one for this project on the service's /admin/ page (http://<host>:9120/admin/). The admin password itself is not a token.
# LAYA_STRATEGY: english-only here; the service default is auto, GET <url>/v1/strategies lists the names.
# LAYA_URL=http://127.0.0.1:9120
# LAYA_STRATEGY=english-only
# LAYA_TOKEN=

# Optional per-run overrides.
# PROVIDER=laya
# CONFIDENCE_THRESHOLD=25
# SKILL_PICKER_BATCH_SIZE=20
