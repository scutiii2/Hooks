# Copy to .env (git-ignored). Anything set here overrides router_config.json.

# Jev fallback (and PROVIDER=jev). Get a key from TypeSafe AI.
TYPESAFE_API_KEY=

# LayaModel service (often on another device). Token only if the service sets LAYA_TOKEN.
# LAYA_URL=http://127.0.0.1:9120
# LAYA_STRATEGY=english-only
# LAYA_TOKEN=

# Optional per-run overrides.
# PROVIDER=laya
# CONFIDENCE_THRESHOLD=25
# SKILL_PICKER_BATCH_SIZE=20
