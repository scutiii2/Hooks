diff --git a/tokeneconomizer/plugin/history.py b/tokeneconomizer/plugin/history.py
new file mode 100644
index 0000000..fa6085a
--- /dev/null
+++ b/tokeneconomizer/plugin/history.py
@@ -0,0 +1,179 @@
+"""Bootstrapping from the sessions Claude Code already saved, before any new one is watched.
+
+Learning enters the plugin in one place: `fold.fold_session` folds a finished session's log into
+its repository's state (micro-skills, tool-pruning evidence, the ledger). An old session is no
+different, so this module only finds the logs under `<claude_history_path>/projects/`, works out
+which repository each ran in, and hands each to `fold_session(..., historical=True)`. Nothing is
+learned a second way.
+
+  * Incremental: `<state root>/history.json` records every log's size, mtime and outcome, so a
+    rescan reads only logs that are new or changed; it is saved as it goes, so an interrupted
+    import resumes where it stopped.
+  * No double counting: `folded.json` (per repository, keyed by session id) is the dedupe, so a
+    session the hooks already folded, or a log seen twice, is learned from once.
+  * Tolerant: a log that is empty, has no prompt or no directory, or that raises, is recorded
+    with its outcome and skipped; the rest go on.
+  * Quiet: a log written to in the last `fold.STALE_S` seconds may be a running session, which
+    its own hooks fold; it is left for the next scan.
+
+Imported records say `historical: true` in `ledger.jsonl` and `folded.json`. The loop guard's
+envelope also learns from the imported turns (`fold_turns`), as it does from live ones.
+"""
+import os
+import time
+
+from .. import loopguard
+from ..trace.claude import CONVERSATION, _is_prompt
+from ..trace.jsonl import records
+from . import fold, hosts, repos
+from .context import LiveContext
+from .store import Store
+
+STATE = "history.json"
+SAVE_EVERY = 25
+RETRY_S = 3600          # an auto-start that never completed is tried again after this long
+
+
+def history_home(cfg):
+    return os.path.abspath(os.path.expanduser(cfg.claude_history_path))
+
+
+def session_files(home):
+    """[(mtime, size, path)] of the session logs under `<home>/projects/*/`, oldest first.
+    Only the top level of each project folder: a session's subagent logs are in a folder of its
+    own and are read with the session."""
+    out = []
+    try:
+        projects = list(os.scandir(os.path.join(home, "projects")))
+    except OSError:
+        return out
+    for d in projects:
+        try:
+            for e in os.scandir(d.path):
+                if e.name.endswith(".jsonl") and e.is_file():
+                    st = e.stat()
+                    out.append((st.st_mtime, st.st_size, e.path))
+        except OSError:
+            continue
+    return sorted(out)
+
+
+def session_cwd(path, limit=500):
+    """The directory a session ran in: the first `cwd` its log records."""
+    for i, ev in enumerate(records(path)):
+        if isinstance(ev.get("cwd"), str) and ev["cwd"]:
+            return ev["cwd"]
+        if i >= limit:
+            break
+    return None
+
+
+def bootstrap_due(root, now=None):
+    """Is this the first start, i.e. has no import ever been begun (or one begun long ago never
+    finished)? Marks it begun, so that only one session start launches it."""
+    st = Store(root)
+    doc = st.read(STATE)
+    now = now or time.time()
+    if doc is not None and (doc.get("completed") or now - doc.get("started", 0) < RETRY_S):
+        return False
+    st.write(STATE, dict(doc or {}, started=now))
+    return True
+
+
+def ingest(root, env, home, now=None, limit=None):
+    """Import the new or changed logs under `home`. Returns {outcome: count}, or None when
+    another import holds the lock."""
+    host = hosts.HOSTS["claude"]()
+    st = Store(root)
+    now = now or time.time()
+    tally = {}
+    with st.locked("history", timeout=0) as got:
+        if not got:
+            return None
+        doc = st.read(STATE) or {}
+        seen = doc.get("files") or {}
+        touched = {}
+        todo = [f for f in session_files(home) if seen.get(f[2], [None, None])[:2] != [f[1], f[0]]]
+        done, cut = 0, False
+        for mtime, size, path in todo:
+            if now - mtime < fold.STALE_S:
+                continue
+            if limit and done >= limit:
+                cut = True
+                break
+            done += 1
+            try:
+                outcome = _import_one(host, root, env, path, touched)
+            except Exception as e:      # a corrupt log must not stop the rest
+                outcome = f"error: {type(e).__name__}: {e}"[:200]
+            seen[path] = [size, mtime, outcome]
+            key = outcome.split(":")[0]
+            tally[key] = tally.get(key, 0) + 1
+            if done % SAVE_EVERY == 0:
+                st.write(STATE, dict(doc, files=seen))
+        for ctx in touched.values():
+            repos.note_repo(root, ctx.repo)
+        st.write(STATE, dict(doc, files=seen, updated=now, **({} if cut else {"completed": now})))
+    return tally
+
+
+def _import_one(host, root, env, path, touched):
+    sid = os.path.splitext(os.path.basename(path))[0]
+    if not host.prompt_count(path):
+        return "empty"               # no prompt: nothing a session could teach
+    cwd = session_cwd(path)
+    if not cwd:
+        return "no_directory"
+    ctx = LiveContext.build(host, cwd, env, session_id=sid, settle=False)
+    rec = fold.fold_session(ctx, sid, path, historical=True)
+    if rec is None:
+        return "already_folded"
+    touched[ctx.repo.key] = ctx
+    return "folded"
+
+
+# ---- the loop guard's envelope ---------------------------------------------------------------
+def _turns(path):
+    """One list of [name, args, result, exit_code] per prompt-turn of a Claude Code log."""
+    turns, cur, calls = [], None, {}
+    for ev in records(path):
+        if _is_prompt(ev):
+            if cur:
+                turns.append(cur)
+            cur, calls = [], {}
+        elif cur is not None and ev.get("type") in CONVERSATION and not ev.get("isSidechain"):
+            content = (ev.get("message") or {}).get("content")
+            for b in content if isinstance(content, list) else ():
+                if not isinstance(b, dict):
+                    continue
+                if b.get("type") == "tool_use":
+                    args = b.get("input") if isinstance(b.get("input"), dict) else {}
+                    calls[b.get("id")] = [str(b.get("name") or ""), args, "", None]
+                    cur.append(calls[b.get("id")])
+                elif b.get("type") == "tool_result" and b.get("tool_use_id") in calls:
+                    text = b.get("content")
+                    if isinstance(text, list):
+                        text = " ".join(x.get("text", "") for x in text if isinstance(x, dict))
+                    call = calls[b["tool_use_id"]]
+                    call[2] = (text if isinstance(text, str) else "")[:hosts.RESULT_CAP]
+                    if b.get("is_error"):
+                        m = hosts._EXIT_RE.search(call[2][:400])
+                        call[3] = int(m.group(1)) if m else 1
+    if cur:
+        turns.append(cur)
+    return turns
+
+
+def fold_turns(ctx, transcript):
+    """Feed an imported session's prompt-turns to the repository's envelope, replayed through
+    the live `TurnGuard` with no envelope and no judge (it observes, and cannot act)."""
+    cfg = ctx.config
+    with ctx.store.locked("envelope"):
+        tracker = loopguard.load_envelope(ctx.store, cfg.loopguard_aggr,
+                                          cfg.loopguard_thresholds)
+        for calls in _turns(transcript):
+            g = loopguard.TurnGuard()
+            for name, args, text, code in calls:
+                g.fold(name, args, text, code)
+            tracker.update(g.cum_turns, g.resolved_proxy(True), snapshot=g.whole.snapshot())
+        loopguard.save_envelope(ctx.store, tracker)
